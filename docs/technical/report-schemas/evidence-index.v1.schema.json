{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entroping.dev/schemas/evidence-index.v1.schema.json",
  "title": "Entroping evidence index packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "summary",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "entroping.evidence-index.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "artifacts_total",
        "artifacts_present",
        "artifacts_missing",
        "artifacts_invalid",
        "artifacts_unsafe"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "partial",
            "insufficient"
          ]
        },
        "artifacts_total": {
          "type": "integer",
          "minimum": 0
        },
        "artifacts_present": {
          "type": "integer",
          "minimum": 0
        },
        "artifacts_missing": {
          "type": "integer",
          "minimum": 0
        },
        "artifacts_invalid": {
          "type": "integer",
          "minimum": 0
        },
        "artifacts_unsafe": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "path",
        "state",
        "schema_version",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/artifact_state"
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "artifact_state": {
      "enum": [
        "present",
        "missing",
        "invalid",
        "unsafe"
      ]
    }
  }
}

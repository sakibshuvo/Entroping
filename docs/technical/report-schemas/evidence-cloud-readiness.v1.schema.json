{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entroping.dev/schemas/evidence-cloud-readiness.v1.schema.json",
  "title": "Entroping Evidence Cloud readiness packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "summary",
    "cloud_boundary",
    "sources",
    "readiness_areas",
    "upload_candidates",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "entroping.evidence-cloud-readiness.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "cloud_boundary": {
      "$ref": "#/$defs/cloud_boundary"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "readiness_areas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/readiness_area"
      }
    },
    "upload_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/upload_candidate"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/next_action"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sources_total",
        "sources_present",
        "sources_missing",
        "sources_invalid",
        "sources_unsafe",
        "areas_total",
        "areas_ready",
        "areas_attention",
        "areas_blocked",
        "upload_candidates_total",
        "upload_candidates_ready",
        "upload_candidates_blocked",
        "blockers_total",
        "next_actions_total"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/readiness_status"
        },
        "sources_total": {
          "type": "integer",
          "minimum": 0
        },
        "sources_present": {
          "type": "integer",
          "minimum": 0
        },
        "sources_missing": {
          "type": "integer",
          "minimum": 0
        },
        "sources_invalid": {
          "type": "integer",
          "minimum": 0
        },
        "sources_unsafe": {
          "type": "integer",
          "minimum": 0
        },
        "areas_total": {
          "type": "integer",
          "minimum": 0
        },
        "areas_ready": {
          "type": "integer",
          "minimum": 0
        },
        "areas_attention": {
          "type": "integer",
          "minimum": 0
        },
        "areas_blocked": {
          "type": "integer",
          "minimum": 0
        },
        "upload_candidates_total": {
          "type": "integer",
          "minimum": 0
        },
        "upload_candidates_ready": {
          "type": "integer",
          "minimum": 0
        },
        "upload_candidates_blocked": {
          "type": "integer",
          "minimum": 0
        },
        "blockers_total": {
          "type": "integer",
          "minimum": 0
        },
        "next_actions_total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cloud_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicit_user_intent_required",
        "upload_implemented",
        "hosted_sync_implemented",
        "access_control_audit_required",
        "forbidden_data_classes",
        "boundary_summary"
      ],
      "properties": {
        "explicit_user_intent_required": {
          "type": "boolean"
        },
        "upload_implemented": {
          "type": "boolean"
        },
        "hosted_sync_implemented": {
          "type": "boolean"
        },
        "access_control_audit_required": {
          "type": "boolean"
        },
        "forbidden_data_classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forbidden_data_class"
          }
        },
        "boundary_summary": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "path",
        "state",
        "schema_version",
        "sha256",
        "summary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/source_id"
        },
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/source_state"
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "readiness_area": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "status",
        "source_ids",
        "boundary",
        "upload_candidate",
        "blockers",
        "next_action"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/area_id"
        },
        "label": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/area_status"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          }
        },
        "boundary": {
          "type": "string"
        },
        "upload_candidate": {
          "type": "boolean"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string"
        }
      }
    },
    "upload_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "state",
        "source_ids",
        "description",
        "blockers"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/upload_candidate_id"
        },
        "label": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/upload_candidate_state"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          }
        },
        "description": {
          "type": "string"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "action",
        "source_ids",
        "area_ids"
      ],
      "properties": {
        "priority": {
          "$ref": "#/$defs/next_action_priority"
        },
        "action": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          }
        },
        "area_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/area_id"
          }
        }
      }
    },
    "readiness_status": {
      "enum": [
        "ready",
        "partial",
        "insufficient"
      ]
    },
    "source_id": {
      "enum": [
        "team_evidence_readiness",
        "evidence_bundle",
        "runtime_card",
        "artifact_manifest",
        "design_partner_feedback",
        "pilot_metrics",
        "integration_readiness",
        "devex_readiness",
        "connector_intent",
        "evidence_index"
      ]
    },
    "source_state": {
      "enum": [
        "present",
        "missing",
        "invalid",
        "unsafe"
      ]
    },
    "area_id": {
      "enum": [
        "team_upload_boundary",
        "runtime_governance_visibility",
        "design_partner_context",
        "integration_connector_surface",
        "developer_experience_surface",
        "cloud_boundary_controls"
      ]
    },
    "area_status": {
      "enum": [
        "ready",
        "attention",
        "blocked"
      ]
    },
    "upload_candidate_id": {
      "enum": [
        "team_evidence_bundle",
        "runtime_governance_card",
        "integration_surface_packet",
        "developer_experience_packet"
      ]
    },
    "upload_candidate_state": {
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "next_action_priority": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "forbidden_data_class": {
      "enum": [
        "raw_traffic",
        "secrets",
        "source_hurl",
        "env_values",
        "prompts",
        "provider_outputs",
        "full_report_contents",
        "design_partner_free_form_text",
        "ticket_payloads",
        "webhook_urls"
      ]
    }
  }
}

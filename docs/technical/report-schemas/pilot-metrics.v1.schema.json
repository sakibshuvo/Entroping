{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sakibshuvo.github.io/Entroping/schemas/pilot-metrics.v1.schema.json",
  "title": "Entroping Pilot Metrics v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "summary",
    "metrics",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "entroping.pilot-metrics.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "metrics_total",
        "metrics_known",
        "metrics_unknown",
        "metrics_manual_input_required",
        "sources_total",
        "sources_present",
        "sources_missing",
        "sources_invalid",
        "sources_unsafe"
      ],
      "properties": {
        "status": {
          "enum": [
            "partial",
            "insufficient"
          ],
          "type": "string"
        },
        "metrics_total": {
          "type": "integer",
          "minimum": 0
        },
        "metrics_known": {
          "type": "integer",
          "minimum": 0
        },
        "metrics_unknown": {
          "type": "integer",
          "minimum": 0
        },
        "metrics_manual_input_required": {
          "type": "integer",
          "minimum": 0
        },
        "sources_total": {
          "type": "integer",
          "minimum": 0
        },
        "sources_present": {
          "type": "integer",
          "minimum": 0
        },
        "sources_missing": {
          "type": "integer",
          "minimum": 0
        },
        "sources_invalid": {
          "type": "integer",
          "minimum": 0
        },
        "sources_unsafe": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "state",
        "value",
        "unit",
        "numerator",
        "denominator",
        "summary",
        "source_paths"
      ],
      "properties": {
        "id": {
          "enum": [
            "setup_time_minutes",
            "evidence_bundle_ready_rate",
            "useful_failures",
            "false_positives",
            "waived_gates",
            "human_steering_events"
          ],
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "state": {
          "enum": [
            "known",
            "unknown",
            "manual_input_required"
          ],
          "type": "string"
        },
        "value": {
          "type": [
            "integer",
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "numerator": {
          "type": [
            "integer",
            "null"
          ]
        },
        "denominator": {
          "type": [
            "integer",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        },
        "source_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "path",
        "state",
        "schema_version",
        "summary"
      ],
      "properties": {
        "id": {
          "enum": [
            "run_report",
            "runtime_card",
            "evidence_bundle",
            "artifact_manifest",
            "agent_bundle"
          ],
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "state": {
          "enum": [
            "present",
            "missing",
            "invalid",
            "unsafe"
          ],
          "type": "string"
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}

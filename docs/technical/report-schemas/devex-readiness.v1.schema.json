{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entroping.dev/schemas/devex-readiness.v1.schema.json",
  "title": "Entroping developer experience readiness packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "summary",
    "sources",
    "families",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "entroping.devex-readiness.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "families": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/next_action"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sources_total",
        "sources_present",
        "sources_missing",
        "sources_invalid",
        "sources_unsafe",
        "families_total",
        "families_ready",
        "families_attention",
        "families_blocked",
        "blockers_total",
        "next_actions_total",
        "first_five_minutes_score",
        "first_five_minutes_readiness_band",
        "missing_source_count",
        "top_next_action"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/readiness_status"
        },
        "sources_total": {
          "type": "integer",
          "minimum": 0
        },
        "sources_present": {
          "type": "integer",
          "minimum": 0
        },
        "sources_missing": {
          "type": "integer",
          "minimum": 0
        },
        "sources_invalid": {
          "type": "integer",
          "minimum": 0
        },
        "sources_unsafe": {
          "type": "integer",
          "minimum": 0
        },
        "families_total": {
          "type": "integer",
          "minimum": 0
        },
        "families_ready": {
          "type": "integer",
          "minimum": 0
        },
        "families_attention": {
          "type": "integer",
          "minimum": 0
        },
        "families_blocked": {
          "type": "integer",
          "minimum": 0
        },
        "blockers_total": {
          "type": "integer",
          "minimum": 0
        },
        "next_actions_total": {
          "type": "integer",
          "minimum": 0
        },
        "first_five_minutes_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "first_five_minutes_readiness_band": {
          "$ref": "#/$defs/readiness_band"
        },
        "missing_source_count": {
          "type": "integer",
          "minimum": 0
        },
        "top_next_action": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "path",
        "state",
        "schema_version",
        "sha256",
        "summary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/source_id"
        },
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/source_state"
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "status",
        "surface_ids",
        "required_source_ids",
        "present_source_ids",
        "missing_source_ids",
        "blockers",
        "link_requirements",
        "action_requirements",
        "forbidden_actions",
        "next_action"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/family_id"
        },
        "label": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/family_status"
        },
        "surface_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surface_id"
          }
        },
        "required_source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          }
        },
        "present_source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          }
        },
        "missing_source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "link_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forbidden_action"
          }
        },
        "next_action": {
          "type": "string"
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "action",
        "source_ids",
        "family_ids"
      ],
      "properties": {
        "priority": {
          "$ref": "#/$defs/next_action_priority"
        },
        "action": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          }
        },
        "family_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/family_id"
          }
        }
      }
    },
    "readiness_status": {
      "enum": [
        "ready",
        "partial",
        "insufficient"
      ],
      "type": "string"
    },
    "source_state": {
      "enum": [
        "present",
        "missing",
        "invalid",
        "unsafe"
      ],
      "type": "string"
    },
    "family_status": {
      "enum": [
        "ready",
        "attention",
        "blocked"
      ],
      "type": "string"
    },
    "next_action_priority": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "type": "string"
    },
    "readiness_band": {
      "enum": [
        "ready",
        "attention",
        "blocked"
      ],
      "type": "string"
    },
    "source_id": {
      "enum": [
        "runtime_card",
        "handoff",
        "evidence_index",
        "integration_readiness",
        "notification_packet",
        "team_access_control_plan"
      ],
      "type": "string"
    },
    "family_id": {
      "enum": [
        "cli",
        "editor",
        "local_workbench",
        "pr_runtime_card",
        "desktop",
        "cloud",
        "mobile"
      ],
      "type": "string"
    },
    "surface_id": {
      "enum": [
        "cli",
        "vscode",
        "editor",
        "local_workbench",
        "pr_runtime_card",
        "desktop",
        "cloud",
        "mobile"
      ],
      "type": "string"
    },
    "forbidden_action": {
      "enum": [
        "execute_hurl",
        "run_tests",
        "call_external_api",
        "invoke_model_provider",
        "upload_artifacts",
        "mutate_external_system",
        "read_provider_keys",
        "override_hurl_qanstitution_result",
        "sync_raw_repo_or_vault",
        "render_raw_artifact_contents",
        "implement_app_surface"
      ],
      "type": "string"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entroping.dev/schemas/notification-packet.v1.schema.json",
  "title": "Entroping work-management notification packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "summary",
    "runtime",
    "sources",
    "messages"
  ],
  "properties": {
    "schema_version": {
      "const": "entroping.notification-packet.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "runtime": {
      "oneOf": [
        {
          "$ref": "#/$defs/runtime"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/message"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "severity",
        "sources_total",
        "sources_present",
        "sources_missing",
        "sources_invalid",
        "sources_unsafe"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "partial",
            "insufficient"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "attention",
            "blocker"
          ]
        },
        "sources_total": {
          "type": "integer",
          "minimum": 0
        },
        "sources_present": {
          "type": "integer",
          "minimum": 0
        },
        "sources_missing": {
          "type": "integer",
          "minimum": 0
        },
        "sources_invalid": {
          "type": "integer",
          "minimum": 0
        },
        "sources_unsafe": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "findings",
        "evidence_links",
        "failed_gate_ids"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_links": {
          "type": "integer",
          "minimum": 0
        },
        "failed_gate_ids": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "path",
        "state",
        "schema_version",
        "sha256",
        "summary"
      ],
      "properties": {
        "id": {
          "enum": [
            "handoff",
            "runtime_card",
            "evidence_bundle",
            "pilot_metrics",
            "artifact_manifest",
            "test_pyramid"
          ]
        },
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "state": {
          "enum": [
            "present",
            "missing",
            "invalid",
            "unsafe"
          ]
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "label",
        "severity",
        "title",
        "body",
        "next_action",
        "artifact_paths"
      ],
      "properties": {
        "surface": {
          "enum": [
            "jira",
            "linear",
            "monday",
            "slack",
            "discord",
            "workato",
            "agent"
          ]
        },
        "label": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "attention",
            "blocker"
          ]
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        },
        "artifact_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

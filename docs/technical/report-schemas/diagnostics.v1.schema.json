{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sakibshuvo/Entroping/docs/technical/report-schemas/diagnostics.v1.schema.json",
  "title": "Entroping Structured Diagnostics v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timestamp",
    "component",
    "operation",
    "severity",
    "code",
    "summary",
    "attributes"
  ],
  "properties": {
    "schema_version": {
      "const": "entroping.diagnostics.v1"
    },
    "timestamp": {
      "type": "string"
    },
    "component": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "severity": {
      "enum": [
        "debug",
        "info",
        "warning",
        "error"
      ]
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,95}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "attributes": {
      "type": "array",
      "description": "Value-free attribute objects sorted by name.",
      "items": {
        "$ref": "#/$defs/attribute"
      }
    }
  },
  "$defs": {
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "value": {
          "type": [
            "string",
            "integer",
            "number",
            "boolean",
            "null"
          ]
        }
      }
    }
  }
}

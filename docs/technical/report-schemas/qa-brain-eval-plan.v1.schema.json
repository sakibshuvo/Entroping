{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entroping.dev/schemas/qa-brain-eval-plan.v1.schema.json",
  "title": "Entroping QA brain eval-plan packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "seed_schema_version",
    "summary",
    "cases",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "entroping.qa-brain-eval-plan.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "seed_schema_version": {
      "const": "entroping.qa-brain-seed.v1"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eval_case"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/next_action"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "cases_total",
        "cases_ready",
        "cases_missing",
        "cases_attention",
        "next_actions_total"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "partial",
            "insufficient"
          ]
        },
        "cases_total": {
          "type": "integer",
          "minimum": 0
        },
        "cases_ready": {
          "type": "integer",
          "minimum": 0
        },
        "cases_missing": {
          "type": "integer",
          "minimum": 0
        },
        "cases_attention": {
          "type": "integer",
          "minimum": 0
        },
        "next_actions_total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "eval_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "readiness",
        "source_ids",
        "source_paths",
        "input_contract",
        "output_contract",
        "acceptance_signal",
        "negative_controls",
        "next_action",
        "evidence_catalog"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/eval_slice_id"
        },
        "label": {
          "type": "string"
        },
        "readiness": {
          "$ref": "#/$defs/case_readiness"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_contract": {
          "type": "string"
        },
        "output_contract": {
          "type": "string"
        },
        "acceptance_signal": {
          "type": "string"
        },
        "negative_controls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string"
        },
        "evidence_catalog": {
          "$ref": "#/$defs/evidence_catalog"
        }
      }
    },
    "evidence_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_sources_total",
        "sources_present",
        "sources_missing",
        "sources_invalid",
        "sources_unsafe",
        "categories",
        "missing_reasons",
        "sources"
      ],
      "properties": {
        "expected_sources_total": {
          "type": "integer",
          "minimum": 0
        },
        "sources_present": {
          "type": "integer",
          "minimum": 0
        },
        "sources_missing": {
          "type": "integer",
          "minimum": 0
        },
        "sources_invalid": {
          "type": "integer",
          "minimum": 0
        },
        "sources_unsafe": {
          "type": "integer",
          "minimum": 0
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalog_category"
          }
        },
        "missing_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/missing_reason"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalog_source"
          }
        }
      }
    },
    "catalog_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "category",
        "schema_version",
        "missing_reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/catalog_source_state"
        },
        "category": {
          "$ref": "#/$defs/catalog_category"
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "missing_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/missing_reason"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "action",
        "case_ids"
      ],
      "properties": {
        "priority": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "action": {
          "type": "string"
        },
        "case_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/eval_slice_id"
          }
        }
      }
    },
    "catalog_source_state": {
      "enum": [
        "present",
        "missing",
        "invalid",
        "unsafe"
      ]
    },
    "catalog_category": {
      "enum": [
        "runtime_governance",
        "policy_governance",
        "generated_test_quality",
        "test_pyramid",
        "api_inventory",
        "mutation_fuzz",
        "redaction_safety",
        "cross_surface_handoff",
        "agent_review",
        "review_signal",
        "generic_evidence"
      ]
    },
    "missing_reason": {
      "enum": [
        "artifact_missing",
        "artifact_invalid",
        "artifact_unsafe"
      ]
    },
    "case_readiness": {
      "enum": [
        "ready",
        "missing",
        "attention"
      ]
    },
    "eval_slice_id": {
      "enum": [
        "weak_test_detection",
        "missing_gate_discovery",
        "unsafe_generated_hurl",
        "bogus_evidence",
        "redaction_mistakes",
        "api_drift_reasoning",
        "mutation_fuzz_readiness",
        "cross_surface_handoff_quality"
      ]
    }
  }
}

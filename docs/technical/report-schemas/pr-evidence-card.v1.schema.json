{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entroping.dev/schemas/pr-evidence-card.v1.schema.json",
  "title": "Entroping PR evidence card packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "summary",
    "sources",
    "checklist",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "entroping.pr-evidence-card.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "checklist": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checklist_item"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/next_action"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sources_total",
        "sources_present",
        "sources_missing",
        "sources_invalid",
        "sources_unsafe",
        "checklist_total",
        "checklist_ready",
        "checklist_attention",
        "checklist_blocked",
        "next_actions_total"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "partial",
            "insufficient"
          ]
        },
        "sources_total": {
          "type": "integer",
          "minimum": 0
        },
        "sources_present": {
          "type": "integer",
          "minimum": 0
        },
        "sources_missing": {
          "type": "integer",
          "minimum": 0
        },
        "sources_invalid": {
          "type": "integer",
          "minimum": 0
        },
        "sources_unsafe": {
          "type": "integer",
          "minimum": 0
        },
        "checklist_total": {
          "type": "integer",
          "minimum": 0
        },
        "checklist_ready": {
          "type": "integer",
          "minimum": 0
        },
        "checklist_attention": {
          "type": "integer",
          "minimum": 0
        },
        "checklist_blocked": {
          "type": "integer",
          "minimum": 0
        },
        "next_actions_total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "path",
        "state",
        "schema_version",
        "sha256",
        "summary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/source_id"
        },
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/source_state"
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "checklist_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "source_id",
        "state",
        "path",
        "schema_version",
        "sha256",
        "summary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/checklist_id"
        },
        "label": {
          "type": "string"
        },
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "state": {
          "$ref": "#/$defs/checklist_state"
        },
        "path": {
          "type": "string"
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "action",
        "source_ids",
        "checklist_ids"
      ],
      "properties": {
        "priority": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "action": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          }
        },
        "checklist_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checklist_id"
          }
        }
      }
    },
    "source_state": {
      "enum": [
        "present",
        "missing",
        "invalid",
        "unsafe"
      ]
    },
    "checklist_state": {
      "enum": [
        "ready",
        "attention",
        "blocked"
      ]
    },
    "source_id": {
      "enum": [
        "runtime-card-json",
        "evidence-bundle-json",
        "test-pyramid-json",
        "mutation-readiness-json",
        "observability-packet-json",
        "integration-readiness-json",
        "devex-readiness-json",
        "connector-intent-json",
        "handoff-json",
        "evidence-cloud-dashboard-json",
        "evidence-index-json"
      ]
    },
    "checklist_id": {
      "enum": [
        "runtime-governance",
        "evidence-completeness",
        "test-pyramid",
        "generated-test-qa",
        "observability",
        "integrations",
        "developer-experience",
        "connector-intent",
        "cross-surface-handoff",
        "evidence-cloud",
        "evidence-index"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entroping.dev/schemas/work-item-import-bundle.v1.schema.json",
  "title": "Entroping work item import bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "summary",
    "sources",
    "rows",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": "entroping.work-item-import-bundle.v1"
    },
    "csv_contract_version": {
      "const": "entroping.work-item-import-csv.v1"
    },
    "csv_columns": {
      "type": "array",
      "prefixItems": [
        {
          "const": "record_type"
        },
        {
          "const": "tracker_family"
        },
        {
          "const": "external_id"
        },
        {
          "const": "title"
        },
        {
          "const": "body"
        },
        {
          "const": "priority"
        },
        {
          "const": "labels"
        },
        {
          "const": "source_ids"
        },
        {
          "const": "source_item_ids"
        },
        {
          "const": "source_action_ids"
        },
        {
          "const": "source_action_count"
        },
        {
          "const": "status"
        },
        {
          "const": "forbidden_actions"
        }
      ],
      "minItems": 13,
      "maxItems": 13
    },
    "generated_at": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/import_row"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sources_total",
        "sources_present",
        "sources_missing",
        "sources_invalid",
        "sources_unsafe",
        "rows_total",
        "rows_high",
        "rows_medium",
        "rows_low",
        "actions_total",
        "actions_high",
        "actions_medium",
        "actions_low",
        "source_item_count",
        "source_action_count"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "partial",
            "insufficient"
          ]
        },
        "sources_total": {
          "type": "integer",
          "minimum": 0
        },
        "sources_present": {
          "type": "integer",
          "minimum": 0
        },
        "sources_missing": {
          "type": "integer",
          "minimum": 0
        },
        "sources_invalid": {
          "type": "integer",
          "minimum": 0
        },
        "sources_unsafe": {
          "type": "integer",
          "minimum": 0
        },
        "rows_total": {
          "type": "integer",
          "minimum": 0
        },
        "rows_high": {
          "type": "integer",
          "minimum": 0
        },
        "rows_medium": {
          "type": "integer",
          "minimum": 0
        },
        "rows_low": {
          "type": "integer",
          "minimum": 0
        },
        "actions_total": {
          "type": "integer",
          "minimum": 0
        },
        "actions_high": {
          "type": "integer",
          "minimum": 0
        },
        "actions_medium": {
          "type": "integer",
          "minimum": 0
        },
        "actions_low": {
          "type": "integer",
          "minimum": 0
        },
        "source_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_action_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "path",
        "state",
        "schema_version",
        "sha256",
        "summary",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/source_id"
        },
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/source_state"
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "import_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "id",
        "tracker_family",
        "external_id",
        "title",
        "body",
        "priority",
        "labels",
        "source_ids",
        "source_item_ids",
        "source_action_ids",
        "source_action_count",
        "forbidden_actions",
        "status"
      ],
      "properties": {
        "record_type": {
          "const": "import_row"
        },
        "id": {
          "type": "string"
        },
        "tracker_family": {
          "$ref": "#/$defs/tracker_family"
        },
        "external_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          }
        },
        "source_item_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_action_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_action_count": {
          "type": "integer",
          "minimum": 0
        },
        "forbidden_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forbidden_action"
          }
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "priority",
        "category",
        "action",
        "source_ids",
        "status"
      ],
      "properties": {
        "record_type": {
          "const": "action"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "category": {
          "$ref": "#/$defs/action_category"
        },
        "action": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          }
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_id": {
      "enum": [
        "work-item-draft-json"
      ]
    },
    "source_state": {
      "enum": [
        "present",
        "missing",
        "invalid",
        "unsafe"
      ]
    },
    "priority": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "action_category": {
      "enum": [
        "generate",
        "repair"
      ]
    },
    "tracker_family": {
      "enum": [
        "jira",
        "linear",
        "monday",
        "github_issues",
        "generic_tracker"
      ]
    },
    "forbidden_action": {
      "enum": [
        "call_external_api",
        "mutate_issue_tracker",
        "post_chat_message",
        "execute_chat_command",
        "upload_artifacts",
        "invoke_model_provider",
        "execute_hurl",
        "run_tests",
        "read_provider_keys",
        "parse_raw_traffic",
        "render_raw_artifact_contents"
      ]
    }
  }
}

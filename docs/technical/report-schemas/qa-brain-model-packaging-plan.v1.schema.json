{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entroping.dev/schemas/qa-brain-model-packaging-plan.v1.schema.json",
  "title": "Entroping QA brain model-packaging plan packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "fine_tune_readiness_schema_version",
    "summary",
    "packaging_plans",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "entroping.qa-brain-model-packaging-plan.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "fine_tune_readiness_schema_version": {
      "const": "entroping.qa-brain-fine-tune-readiness.v1"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "packaging_plans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/packaging_plan"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/next_action"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "plans_total",
        "plans_ready",
        "plans_missing",
        "plans_attention",
        "blockers_total",
        "next_actions_total"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "partial",
            "insufficient"
          ]
        },
        "plans_total": {
          "type": "integer",
          "minimum": 0
        },
        "plans_ready": {
          "type": "integer",
          "minimum": 0
        },
        "plans_missing": {
          "type": "integer",
          "minimum": 0
        },
        "plans_attention": {
          "type": "integer",
          "minimum": 0
        },
        "blockers_total": {
          "type": "integer",
          "minimum": 0
        },
        "next_actions_total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "packaging_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "label",
        "readiness",
        "source_ids",
        "source_paths",
        "packaging_stage",
        "endpoint_boundary",
        "litellm_routing_boundary",
        "deployment_modes",
        "artifact_boundary",
        "access_control_audit",
        "blockers",
        "next_action"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/eval_slice_id"
        },
        "label": {
          "type": "string"
        },
        "readiness": {
          "$ref": "#/$defs/case_readiness"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packaging_stage": {
          "$ref": "#/$defs/packaging_stage"
        },
        "endpoint_boundary": {
          "type": "string"
        },
        "litellm_routing_boundary": {
          "type": "string"
        },
        "deployment_modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deployment_mode"
          }
        },
        "artifact_boundary": {
          "type": "string"
        },
        "access_control_audit": {
          "type": "string"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string"
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "action",
        "case_ids"
      ],
      "properties": {
        "priority": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "action": {
          "type": "string"
        },
        "case_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/eval_slice_id"
          }
        }
      }
    },
    "packaging_stage": {
      "enum": [
        "packaging_ready",
        "needs_readiness_evidence",
        "needs_boundary_repair"
      ]
    },
    "deployment_mode": {
      "enum": [
        "hosted",
        "local",
        "enterprise"
      ]
    },
    "case_readiness": {
      "enum": [
        "ready",
        "missing",
        "attention"
      ]
    },
    "eval_slice_id": {
      "enum": [
        "weak_test_detection",
        "missing_gate_discovery",
        "unsafe_generated_hurl",
        "bogus_evidence",
        "redaction_mistakes",
        "api_drift_reasoning",
        "mutation_fuzz_readiness",
        "cross_surface_handoff_quality"
      ]
    }
  }
}

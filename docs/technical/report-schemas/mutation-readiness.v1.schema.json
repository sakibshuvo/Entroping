{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entroping.dev/schemas/mutation-readiness.v1.schema.json",
  "title": "Entroping mutation readiness packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "summary",
    "sources",
    "candidates",
    "seeded_fuzz_candidates"
  ],
  "properties": {
    "schema_version": {
      "const": "entroping.mutation-readiness.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "seeded_fuzz_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/seeded_fuzz_candidate"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sources_total",
        "sources_present",
        "sources_missing",
        "sources_invalid",
        "sources_unsafe",
        "generated_tests",
        "negative_tests",
        "security_tests",
        "assertions_total",
        "seed_metadata_tests",
        "candidate_categories_total",
        "seeded_fuzz_candidates_total",
        "optional_reports_present",
        "optional_reports_invalid",
        "optional_reports_unsafe"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "partial",
            "insufficient"
          ]
        },
        "sources_total": {
          "type": "integer",
          "minimum": 0
        },
        "sources_present": {
          "type": "integer",
          "minimum": 0
        },
        "sources_missing": {
          "type": "integer",
          "minimum": 0
        },
        "sources_invalid": {
          "type": "integer",
          "minimum": 0
        },
        "sources_unsafe": {
          "type": "integer",
          "minimum": 0
        },
        "generated_tests": {
          "type": "integer",
          "minimum": 0
        },
        "negative_tests": {
          "type": "integer",
          "minimum": 0
        },
        "security_tests": {
          "type": "integer",
          "minimum": 0
        },
        "assertions_total": {
          "type": "integer",
          "minimum": 0
        },
        "seed_metadata_tests": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_categories_total": {
          "type": "integer",
          "minimum": 0
        },
        "seeded_fuzz_candidates_total": {
          "type": "integer",
          "minimum": 0
        },
        "optional_reports_present": {
          "type": "integer",
          "minimum": 0
        },
        "optional_reports_invalid": {
          "type": "integer",
          "minimum": 0
        },
        "optional_reports_unsafe": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "state",
        "schema_version",
        "tags",
        "candidate_categories",
        "assertions",
        "seed_metadata",
        "summary"
      ],
      "properties": {
        "kind": {
          "enum": [
            "generated_hurl",
            "test_quality_report",
            "test_pyramid_report"
          ]
        },
        "path": {
          "type": "string"
        },
        "state": {
          "enum": [
            "present",
            "missing",
            "invalid",
            "unsafe"
          ]
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidate_category"
          }
        },
        "assertions": {
          "type": "integer",
          "minimum": 0
        },
        "seed_metadata": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "label",
        "tests",
        "source_paths",
        "next_action"
      ],
      "properties": {
        "category": {
          "$ref": "#/$defs/candidate_category"
        },
        "label": {
          "type": "string"
        },
        "tests": {
          "type": "integer",
          "minimum": 0
        },
        "source_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string"
        }
      }
    },
    "seeded_fuzz_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "source_path",
        "assertions",
        "seed_metadata",
        "next_action"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/candidate_category"
        },
        "source_path": {
          "type": "string"
        },
        "assertions": {
          "type": "integer",
          "minimum": 0
        },
        "seed_metadata": {
          "type": "boolean"
        },
        "next_action": {
          "type": "string"
        }
      }
    },
    "candidate_category": {
      "enum": [
        "status_code",
        "schema",
        "auth",
        "latency",
        "request_shape",
        "response_shape"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entroping.dev/schemas/qa-brain-seed.v1.schema.json",
  "title": "Entroping QA brain seed packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "summary",
    "sources",
    "eval_slices",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "entroping.qa-brain-seed.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "eval_slices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/eval_slice"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/next_action"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sources_total",
        "sources_present",
        "sources_missing",
        "sources_invalid",
        "sources_unsafe",
        "eval_slices_total",
        "eval_slices_ready",
        "next_actions_total"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "partial",
            "insufficient"
          ]
        },
        "sources_total": {
          "type": "integer",
          "minimum": 0
        },
        "sources_present": {
          "type": "integer",
          "minimum": 0
        },
        "sources_missing": {
          "type": "integer",
          "minimum": 0
        },
        "sources_invalid": {
          "type": "integer",
          "minimum": 0
        },
        "sources_unsafe": {
          "type": "integer",
          "minimum": 0
        },
        "eval_slices_total": {
          "type": "integer",
          "minimum": 0
        },
        "eval_slices_ready": {
          "type": "integer",
          "minimum": 0
        },
        "next_actions_total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "path",
        "state",
        "schema_version",
        "category",
        "eval_slices",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/source_state"
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "$ref": "#/$defs/seed_category"
        },
        "eval_slices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/eval_slice_id"
          }
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "eval_slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "status",
        "source_ids",
        "source_paths",
        "next_action"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/eval_slice_id"
        },
        "label": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "missing",
            "attention"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_action": {
          "type": "string"
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "action",
        "source_ids"
      ],
      "properties": {
        "priority": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "action": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "seed_category": {
      "enum": [
        "runtime_governance",
        "policy_governance",
        "generated_test_quality",
        "test_pyramid",
        "api_inventory",
        "mutation_fuzz",
        "redaction_safety",
        "cross_surface_handoff",
        "agent_review",
        "review_signal",
        "generic_evidence"
      ]
    },
    "eval_slice_id": {
      "enum": [
        "weak_test_detection",
        "missing_gate_discovery",
        "unsafe_generated_hurl",
        "bogus_evidence",
        "redaction_mistakes",
        "api_drift_reasoning",
        "mutation_fuzz_readiness",
        "cross_surface_handoff_quality"
      ]
    },
    "source_state": {
      "enum": [
        "present",
        "missing",
        "invalid",
        "unsafe"
      ]
    }
  }
}

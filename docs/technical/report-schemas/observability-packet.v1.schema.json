{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entroping.dev/schemas/observability-packet.v1.schema.json",
  "title": "Entroping observability signal packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "summary",
    "runtime",
    "sources",
    "events",
    "components",
    "messages"
  ],
  "properties": {
    "schema_version": {
      "const": "entroping.observability-packet.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "runtime": {
      "oneOf": [
        {
          "$ref": "#/$defs/runtime"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/message"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "severity",
        "sources_total",
        "sources_present",
        "sources_missing",
        "sources_invalid",
        "sources_unsafe",
        "events_total",
        "debug_events",
        "info_events",
        "warning_events",
        "error_events"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "partial",
            "insufficient"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "attention",
            "blocker"
          ]
        },
        "sources_total": {
          "type": "integer",
          "minimum": 0
        },
        "sources_present": {
          "type": "integer",
          "minimum": 0
        },
        "sources_missing": {
          "type": "integer",
          "minimum": 0
        },
        "sources_invalid": {
          "type": "integer",
          "minimum": 0
        },
        "sources_unsafe": {
          "type": "integer",
          "minimum": 0
        },
        "events_total": {
          "type": "integer",
          "minimum": 0
        },
        "debug_events": {
          "type": "integer",
          "minimum": 0
        },
        "info_events": {
          "type": "integer",
          "minimum": 0
        },
        "warning_events": {
          "type": "integer",
          "minimum": 0
        },
        "error_events": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "findings",
        "evidence_links",
        "failed_gate_ids"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_links": {
          "type": "integer",
          "minimum": 0
        },
        "failed_gate_ids": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "path",
        "state",
        "schema_version",
        "sha256",
        "summary"
      ],
      "properties": {
        "id": {
          "enum": [
            "diagnostics",
            "runtime_card",
            "evidence_index"
          ]
        },
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "state": {
          "enum": [
            "present",
            "missing",
            "invalid",
            "unsafe"
          ]
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "operation",
        "severity",
        "code",
        "summary"
      ],
      "properties": {
        "component": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "debug",
            "info",
            "warning",
            "error"
          ]
        },
        "code": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "events_total",
        "debug_events",
        "info_events",
        "warning_events",
        "error_events",
        "operations",
        "codes"
      ],
      "properties": {
        "component": {
          "type": "string"
        },
        "events_total": {
          "type": "integer",
          "minimum": 0
        },
        "debug_events": {
          "type": "integer",
          "minimum": 0
        },
        "info_events": {
          "type": "integer",
          "minimum": 0
        },
        "warning_events": {
          "type": "integer",
          "minimum": 0
        },
        "error_events": {
          "type": "integer",
          "minimum": 0
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "label",
        "severity",
        "title",
        "body",
        "next_action",
        "artifact_paths"
      ],
      "properties": {
        "surface": {
          "enum": [
            "opentelemetry",
            "datadog",
            "splunk",
            "grafana",
            "generic"
          ]
        },
        "label": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "attention",
            "blocker"
          ]
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        },
        "artifact_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

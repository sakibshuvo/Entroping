{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entroping.dev/schemas/evidence-action-plan.v1.schema.json",
  "title": "Entroping evidence action plan packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "summary",
    "sources",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": "entroping.evidence-action-plan.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sources_total",
        "sources_present",
        "sources_missing",
        "sources_invalid",
        "sources_unsafe",
        "sources_blocked",
        "sources_attention",
        "actions_total",
        "actions_high",
        "actions_medium",
        "actions_low"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "partial",
            "insufficient"
          ]
        },
        "sources_total": {
          "type": "integer",
          "minimum": 0
        },
        "sources_present": {
          "type": "integer",
          "minimum": 0
        },
        "sources_missing": {
          "type": "integer",
          "minimum": 0
        },
        "sources_invalid": {
          "type": "integer",
          "minimum": 0
        },
        "sources_unsafe": {
          "type": "integer",
          "minimum": 0
        },
        "sources_blocked": {
          "type": "integer",
          "minimum": 0
        },
        "sources_attention": {
          "type": "integer",
          "minimum": 0
        },
        "actions_total": {
          "type": "integer",
          "minimum": 0
        },
        "actions_high": {
          "type": "integer",
          "minimum": 0
        },
        "actions_medium": {
          "type": "integer",
          "minimum": 0
        },
        "actions_low": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "path",
        "state",
        "schema_version",
        "sha256",
        "summary",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/source_id"
        },
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/source_state"
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "category",
        "action",
        "source_ids",
        "status"
      ],
      "properties": {
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "action": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          }
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_id": {
      "enum": [
        "pr-evidence-card-json",
        "evidence-portal-json",
        "evidence-links-json",
        "evidence-cloud-dashboard-json",
        "devex-readiness-json",
        "integration-readiness-json",
        "connector-intent-json",
        "observability-packet-json",
        "mutation-readiness-json",
        "test-pyramid-json"
      ]
    },
    "source_state": {
      "enum": [
        "present",
        "missing",
        "invalid",
        "unsafe"
      ]
    },
    "priority": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "category": {
      "enum": [
        "generate",
        "repair",
        "review"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entroping.dev/schemas/observability-adapter-readiness.v1.schema.json",
  "title": "Entroping observability adapter readiness packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "project",
    "summary",
    "sources",
    "adapters",
    "boundary_controls",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "entroping.observability-adapter-readiness.v1"
    },
    "generated_at": {
      "type": "string"
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "adapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adapter"
      }
    },
    "boundary_controls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boundary_control"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/next_action"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "severity",
        "sources_total",
        "sources_present",
        "sources_missing",
        "sources_invalid",
        "sources_unsafe",
        "adapters_total",
        "adapters_ready",
        "adapters_attention",
        "adapters_blocked",
        "boundary_controls"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "partial",
            "insufficient"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "attention",
            "blocker"
          ]
        },
        "sources_total": {
          "type": "integer",
          "minimum": 0
        },
        "sources_present": {
          "type": "integer",
          "minimum": 0
        },
        "sources_missing": {
          "type": "integer",
          "minimum": 0
        },
        "sources_invalid": {
          "type": "integer",
          "minimum": 0
        },
        "sources_unsafe": {
          "type": "integer",
          "minimum": 0
        },
        "adapters_total": {
          "type": "integer",
          "minimum": 0
        },
        "adapters_ready": {
          "type": "integer",
          "minimum": 0
        },
        "adapters_attention": {
          "type": "integer",
          "minimum": 0
        },
        "adapters_blocked": {
          "type": "integer",
          "minimum": 0
        },
        "boundary_controls": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "path",
        "state",
        "schema_version",
        "sha256",
        "summary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/source_id"
        },
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "state": {
          "enum": [
            "present",
            "missing",
            "invalid",
            "unsafe"
          ]
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "status",
        "required_source_ids",
        "optional_source_ids",
        "summary",
        "next_action",
        "forbidden_fields"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/adapter_id"
        },
        "label": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "attention",
            "blocked"
          ]
        },
        "required_source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          }
        },
        "optional_source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          }
        },
        "summary": {
          "type": "string"
        },
        "next_action": {
          "type": "string"
        },
        "forbidden_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "boundary_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "const": "active"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "action",
        "source_ids",
        "adapter_ids"
      ],
      "properties": {
        "priority": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "action": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          }
        },
        "adapter_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/adapter_id"
          }
        }
      }
    },
    "source_id": {
      "enum": [
        "observability_packet",
        "otel_mapping",
        "evidence_index",
        "runtime_card"
      ]
    },
    "adapter_id": {
      "enum": [
        "opentelemetry",
        "datadog",
        "splunk",
        "grafana",
        "generic"
      ]
    }
  }
}

const densityCount = {
  hero: 30,
  section: 18,
  docs: 8,
} as const satisfies Record<Density, number>;
const { density } = Astro.props;
const visibleGlyphs = glyphs.slice(0, densityCount[density]);
---

<div class:list={["glyph-field", `glyph-field--${density}`]} aria-hidden="true">
  {
    visibleGlyphs.map((glyph) => (
      <span
        class:list={["glyph-field__mark", `glyph-field__mark--${glyph.color}`]}
        style={`--glyph-x:${glyph.x};--glyph-y:${glyph.y};--glyph-size:${glyph.size};--glyph-delay:${glyph.delay};--glyph-rotation:${glyph.rotation}`}
      >
        {glyph.mark}
      </span>
    ))
  }
</div>

<style>
  .glyph-field {
    --glyph-final-opacity: 1;

    inset: 0;
    overflow: hidden;
    pointer-events: none;
    position: absolute;
  }

  .glyph-field__mark {
    animation: glyph-settle var(--motion-emphasis) both;
    animation-delay: var(--glyph-delay);
    font-family: var(--font-mono);
    font-size: var(--glyph-size);
    font-weight: 700;
    left: var(--glyph-x);
    line-height: 1;
    opacity: 0;
    position: absolute;
    top: var(--glyph-y);
    transform: translate3d(-12px, -18px, 0) rotate(var(--glyph-rotation));
  }

  .glyph-field--docs .glyph-field__mark {
    --glyph-final-opacity: 0.52;
  }

  .glyph-field--section .glyph-field__mark {
    --glyph-final-opacity: 0.72;
  }

  .glyph-field__mark--cobalt {
    color: var(--color-cobalt);
  }

  .glyph-field__mark--coral {
    color: var(--color-coral);
  }

  .glyph-field__mark--lavender {
    color: var(--color-lavender);
  }

  .glyph-field__mark--sage {
    color: var(--color-sage);
  }

  .glyph-field__mark--butter {
    color: var(--color-butter);
  }

  .glyph-field__mark--ink {
    color: var(--color-ink);
  }

  @keyframes glyph-settle {
    to {
      opacity: var(--glyph-final-opacity);
      transform: translate3d(0, 0, 0) rotate(var(--glyph-rotation));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glyph-field__mark {
      animation: none;
      opacity: var(--glyph-final-opacity);
      transform: rotate(var(--glyph-rotation));
    }
  }

  @media (min-width: 48rem) {
    .glyph-field__mark:nth-child(6) {
      display: none;
    }
  }
</style>

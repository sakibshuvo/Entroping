---
import CodeWindow from "./CodeWindow.astro";
import SectionBand from "./SectionBand.astro";
import { withBase } from "../config/base-path";

const checkoutCommand = `git clone https://github.com/sakibshuvo/Entroping.git
cd Entroping
brew install uv hurl
scripts/demo.sh`;
const packageCommand = "entroping demo --project ./entroping-checkout-demo";
---

<SectionBand variant="lavender-soft" id="demo" labelledBy="demo-heading">
  <div class="demo">
    <div class="demo__intro">
      <p class="demo__eyebrow">Two-minute proof</p>
      <h2 id="demo-heading">Test a sample API locally.</h2>
      <p class="demo__lead">
        Clone the repository and run the reviewed checkout fixture, or use the
        installed-package command in a new or empty demo directory.
      </p>
      <p class="demo__platform-note">
        The checkout command below is for macOS.
        <a href={withBase("docs/user/user-guide/#2-install")}
          >Linux setup and Windows support status</a
        > are documented separately. Windows is currently limited to doctor checks;
        the API proof is not yet supported there.
      </p>
    </div>
    <div class="demo__commands">
      <CodeWindow
        label="Repository checkout"
        code={checkoutCommand}
        result="Hurl passes and writes JSON, JUnit, and HTML reports."
      />
      <CodeWindow
        label="Installed package"
        code={packageCommand}
        result="No provider credentials or external API calls are required."
      />
    </div>
  </div>
</SectionBand>

<style>
  .demo {
    display: grid;
    gap: var(--space-12);
  }

  .demo__intro {
    max-width: var(--prose-max-width);
  }

  .demo__eyebrow {
    color: var(--color-cobalt);
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    margin: 0 0 var(--space-3);
    text-transform: uppercase;
  }

  h2 {
    font-size: var(--text-section);
    letter-spacing: -0.055em;
    line-height: 0.9;
    margin: 0;
  }

  .demo__lead {
    color: var(--color-ink-muted);
    font-size: var(--text-lead);
    margin: var(--space-6) 0 0;
  }

  .demo__platform-note {
    color: var(--color-ink-muted);
    font-size: var(--text-body-small);
    margin: var(--space-4) 0 0;
  }

  .demo__platform-note a {
    color: var(--color-cobalt);
    font-weight: 700;
  }

  .demo__platform-note a:focus-visible {
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-focus);
    outline: none;
  }

  .demo__commands {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 48rem) {
    .demo {
      align-items: start;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }
</style>

---
import KineticGlyphField from "./KineticGlyphField.astro";
import HeroMessage from "./HeroMessage.astro";
import PassMatrix from "./PassMatrix.astro";
import TiltButton from "./TiltButton.astro";
import { withBase } from "../config/base-path";
---

<section class="hero" aria-labelledby="hero-heading">
  <KineticGlyphField density="hero" />
  <div class="hero__inner">
    <div class="hero__statement">
      <h1 id="hero-heading">
        <span class="hero__line hero__line--first">
          <span class="hero__phrase">Code</span>{" "}
          <span class="hero__phrase">at the speed</span>{" "}
          <span class="hero__phrase">of <em>AI</em>.</span>
        </span>{" "}
        <span class="hero__line hero__line--second">
          <strong>
            <span class="hero__phrase">Don't</span>{" "}
            <span class="hero__phrase">crash</span>
          </strong>{" "}
          <span class="hero__phrase">at the speed</span>{" "}
          <span class="hero__phrase">of <em>AI</em>.</span>
        </span>
      </h1>
      <p class="hero__speed-note">
        <span>// write fast</span>{" "}
        <span>verify faster</span>
      </p>
    </div>
    <HeroMessage />
    <div class="hero__proof">
      <PassMatrix />
    </div>
    <div class="hero__actions">
      <TiltButton href="#demo" variant="primary" icon="play">
        Run a 2-minute API proof
      </TiltButton>
      <TiltButton href={withBase("docs/")} variant="secondary" icon="book">
        Read the docs
      </TiltButton>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--color-sky);
    min-height: calc(100dvh - var(--space-20));
    overflow: hidden;
    padding: 0 var(--gutter-mobile);
    position: relative;
  }

  .hero::after {
    background: var(--color-cloud);
    bottom: 0;
    content: "";
    height: var(--space-4);
    left: 0;
    position: absolute;
    right: 0;
  }

  .hero__inner {
    display: grid;
    gap: var(--space-3);
    margin-inline: auto;
    max-width: var(--launch-max-width);
    position: relative;
    z-index: 1;
  }

  .hero__statement {
    position: relative;
  }

  h1 {
    font-size: var(--text-hero);
    font-weight: 700;
    letter-spacing: -0.065em;
    line-height: 0.84;
    margin: var(--space-2) 0 0;
    max-width: 100%;
  }

  .hero__line {
    display: block;
  }

  .hero__phrase {
    display: block;
  }

  .hero__line--second {
    margin-block-start: var(--space-2);
  }

  .hero__speed-note {
    background: var(--color-sky);
    box-shadow: var(--shadow-mask-sky);
    color: var(--color-lavender);
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    font-weight: 600;
    letter-spacing: 0.025em;
    line-height: 1.25;
    margin: 0;
    pointer-events: none;
    position: absolute;
    right: clamp(var(--space-2), 10vw, var(--space-12));
    top: clamp(
      calc(var(--space-24) + var(--space-4)),
      35vw,
      calc(var(--space-24) + var(--space-16))
    );
  }

  .hero__speed-note span {
    display: block;
  }

  em {
    color: var(--color-cobalt);
    font-style: normal;
  }

  strong {
    color: var(--color-coral);
    display: block;
    text-shadow: 0.05em 0.06em 0 var(--color-ink);
  }

  .hero__proof {
    background: var(--color-sky);
    box-shadow: var(--shadow-mask-sky);
    justify-self: stretch;
  }

  .hero__actions {
    display: grid;
    gap: var(--space-3);
  }

  @media (min-width: 30rem) {
    .hero__actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block-start: var(--space-4);
    }

    .hero__inner {
      gap: var(--space-6);
    }

    h1 {
      font-size: clamp(4.75rem, 12vw, 7rem);
      margin-block-start: var(--space-4);
    }

    .hero__phrase,
    strong {
      display: inline;
    }

    .hero__speed-note {
      right: var(--space-4);
      top: calc(var(--space-24) + var(--space-12));
    }

    .hero__line--second {
      margin-block-start: var(--space-4);
    }

    .hero__actions {
      gap: var(--space-5);
    }
  }

  @media (min-width: 64rem) {
    .hero {
      padding: var(--space-16) var(--gutter-desktop) var(--space-24);
    }

    .hero__inner {
      align-items: end;
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .hero__statement {
      grid-column: 1 / 13;
    }

    h1 {
      font-size: clamp(5rem, 8vw, 8rem);
      max-width: none;
    }

    .hero__speed-note {
      right: var(--space-16);
      top: calc(var(--space-24) + var(--space-12));
    }

    .hero__line--second {
      margin-inline-start: 0.4em;
    }

    :global(.hero-message) {
      grid-column: 1 / 4;
    }

    .hero__proof {
      align-self: center;
      grid-column: 4 / 7;
    }

    .hero__actions {
      align-self: center;
      grid-column: 7 / 13;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
  }

  @media (min-width: 80rem) {
    .hero__actions :global(.tilt-button > span) {
      white-space: nowrap;
    }
  }
</style>

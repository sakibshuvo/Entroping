---
type Props = {
  readonly variant: "sky" | "cloud" | "coral-soft" | "lavender-soft";
  readonly id?: string;
  readonly labelledBy?: string;
};

const { variant, id, labelledBy } = Astro.props;
---

<section
  class:list={["section-band", `section-band--${variant}`]}
  id={id}
  aria-labelledby={labelledBy}
>
  <div class="section-band__inner"><slot /></div>
</section>

<style>
  .section-band {
    padding: var(--space-16) var(--gutter-mobile);
  }

  .section-band__inner {
    margin-inline: auto;
    max-width: var(--launch-max-width);
  }

  .section-band--sky {
    background: var(--color-sky);
  }

  .section-band--cloud {
    background: var(--color-cloud);
  }

  .section-band--coral-soft {
    background: var(--color-coral-soft);
  }

  .section-band--lavender-soft {
    background: var(--color-lavender-soft);
  }

  @media (min-width: 64rem) {
    .section-band {
      padding: var(--space-24) var(--gutter-desktop);
    }
  }
</style>

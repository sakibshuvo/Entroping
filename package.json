{
  "name": "entroping-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:clean": "node scripts/clean-site-build.mjs && astro build",
    "check": "astro check",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:deps": "npm ls --all",
    "test:security": "npm audit --omit=dev",
    "test:site": "node scripts/check-site-build.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --grep-invert @visual",
    "test:e2e:visual": "playwright test tests/site/visual.spec.ts",
    "test:e2e:update": "playwright test tests/site/visual.spec.ts --update-snapshots"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/starlight": "0.41.3",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource-variable/space-grotesk": "5.2.10",
    "astro": "7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@img/sharp-wasm32": "0.35.3",
    "@napi-rs/wasm-runtime": "1.1.6",
    "@playwright/test": "1.61.1",
    "playwright-core": "1.61.1",
    "prettier": "3.9.5",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ]
  }
}
